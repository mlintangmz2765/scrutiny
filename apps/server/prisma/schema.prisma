generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Append-only — there is deliberately no update/delete path for audit rows.
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String // CREATE | UPDATE | DELETE | STATUS | LOGIN | LOGIN_FAILED
  entityType   String
  entityId     String
  engagementId String?
  changes      String? // JSON: { field: [old, new] }
  createdAt    DateTime @default(now())

  @@index([engagementId, createdAt])
  @@index([createdAt])
}

model Client {
  id                 String   @id @default(cuid())
  name               String
  registrationNumber String?
  industry           String?
  contactName        String?
  contactEmail       String?
  notes              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  engagements Engagement[]
}

model Engagement {
  id                 String             @id @default(cuid())
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id])
  name               String
  periodStart        DateTime
  periodEnd          DateTime
  currencyCode       String             @default("USD")
  minorUnitsPerMajor Int                @default(100)
  // PLANNING | FIELDWORK | REVIEW | COMPLETION | ARCHIVED (DOMAIN.md §1)
  status             String             @default("PLANNING")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  members            EngagementMember[]
  accounts           Account[]
  tbImports          TrialBalanceImport[]
  accountMappings    AccountMapping[]

  @@index([clientId])
}

model EngagementMember {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([engagementId, userId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // ADMIN | PARTNER | MANAGER | STAFF — SQLite has no enums; validated by
  // userRoleSchema in @scrutiny/shared (see docs/DECISIONS.md).
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  engagementMemberships EngagementMember[]
  trialBalanceImports   TrialBalanceImport[]
}

// Standard FSLI taxonomy (DOMAIN.md §2). Global, seeded, not engagement-scoped.
model FsliGroup {
  id         String @id @default(cuid())
  code       String @unique
  name       String
  statement  String // BS | IS
  normalSign String // DR | CR
  sortOrder  Int

  mappings AccountMapping[]
}

// A GL account belonging to one engagement's chart of accounts.
model Account {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])
  code         String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  lines   TrialBalanceLine[]
  mapping AccountMapping?

  @@unique([engagementId, code])
  @@index([engagementId])
}

// One active import per (engagement, kind); re-import replaces its lines.
model TrialBalanceImport {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])
  kind         String // CURRENT | PRIOR
  fileName     String
  importedById String
  importedBy   User       @relation(fields: [importedById], references: [id])
  importedAt   DateTime   @default(now())
  rowCount     Int

  lines TrialBalanceLine[]

  @@unique([engagementId, kind])
  @@index([engagementId])
}

model TrialBalanceLine {
  id        String             @id @default(cuid())
  importId  String
  import    TrialBalanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  accountId String
  account   Account            @relation(fields: [accountId], references: [id])
  amount    BigInt // signed minor units: debit +, credit −

  @@index([importId])
  @@index([accountId])
}

// Each account maps to exactly one FSLI group within its engagement.
model AccountMapping {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])
  accountId    String     @unique
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fsliGroupId  String
  fsliGroup    FsliGroup  @relation(fields: [fsliGroupId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([engagementId])
  @@index([fsliGroupId])
}
